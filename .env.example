# Zoiko Rooms AI Assistant - Environment Variables
# Copy this file to .env.local and fill in the values

# Database (PostgreSQL 18 + pgvector)
DATABASE_URL=postgresql://username:password@localhost:5432/zoiko_rooms_assistant

# Model Provider: openai (default), anthropic, or groq
# ASSISTANT_MODEL_PROVIDER=openai
# OPENAI_API_KEY=sk-your-openai-api-key-here
# ASSISTANT_MODEL_ID=gpt-4o
# ASSISTANT_MODEL_PROVIDER=anthropic
# ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key-here
# ASSISTANT_MODEL_ID=claude-sonnet-4-20250514
# ASSISTANT_MODEL_PROVIDER=groq
# GROQ_API_KEY=gsk_your-groq-api-key-here
# ASSISTANT_MODEL_ID=openai/gpt-oss-120b
ASSISTANT_MAX_TOKENS=4096
ASSISTANT_TEMPERATURE=0.3

# Retrieval Settings
ASSISTANT_MAX_CHUNKS=8
ASSISTANT_MIN_SCORE=0.45
ASSISTANT_RERANK_TOP_K=4

# Security
ASSISTANT_SECRET_KEY=change-this-to-a-random-secret-key-in-production
ASSISTANT_SESSION_TTL_MS=3600000
ASSISTANT_MAX_TURNS=100

# Rate Limiting
ASSISTANT_ANON_RPM=20
ASSISTANT_AUTH_RPM=60

# Features
ASSISTANT_ENABLED_MARKETS=GB
ASSISTANT_DEFAULT_MARKET=GB
ASSISTANT_HANDOFF_ENABLED=true
ASSISTANT_FEEDBACK_ENABLED=true
